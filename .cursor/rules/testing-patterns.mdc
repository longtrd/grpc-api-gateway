    return &domain.User{
        ID:    "",
        Name:  "",
        Email: "invalid-email",
    }
}
```

### Assertion Helpers
Create custom assertion helpers for domain-specific validations:

```go
func AssertUserEqual(t *testing.T, expected, actual *domain.User) {
    t.Helper()
    assert.Equal(t, expected.ID, actual.ID)
    assert.Equal(t, expected.Name, actual.Name)
    assert.Equal(t, expected.Email, actual.Email)
}

func AssertErrorType(t *testing.T, expectedErr, actualErr error) {
    t.Helper()
    assert.Error(t, actualErr)
    assert.ErrorIs(t, actualErr, expectedErr)
}
```

## Integration Testing Patterns

### End-to-End Workflow Testing
Test complete workflows as shown in [tests/integration/user_integration_test.go](mdc:gRPC-server/tests/integration/user_integration_test.go):

```go
func TestUserIntegration_CompleteWorkflow(t *testing.T) {
    repo := repository.NewMemoryUserRepository()
    validator := validator.NewUserValidator()
    logger := logger.NewNullLogger()
    publisher := events.NewNullPublisher()

    useCase := usecase.NewUserUseCase(repo, validator, logger, publisher)

    // Test create
    user := testutil.NewValidUser()
    err := useCase.CreateUser(context.Background(), user)
    assert.NoError(t, err)

    // Test get
    retrieved, err := useCase.GetUser(context.Background(), user.ID)
    assert.NoError(t, err)
    testutil.AssertUserEqual(t, user, retrieved)

    // Test update
    user.Name = "Updated Name"
    err = useCase.UpdateUser(context.Background(), user)
    assert.NoError(t, err)

    // Test delete
    err = useCase.DeleteUser(context.Background(), user.ID)
    assert.NoError(t, err)
}
```

### Concurrent Testing
Test thread safety and concurrent operations:

```go
func TestUserIntegration_ConcurrentOperations(t *testing.T) {
    repo := repository.NewMemoryUserRepository()
    useCase := usecase.NewUserUseCase(repo, validator, logger, publisher)

    const numGoroutines = 100
    var wg sync.WaitGroup
    errors := make(chan error, numGoroutines)

    for i := 0; i < numGoroutines; i++ {
        wg.Add(1)
        go func(id int) {
            defer wg.Done()
            user := testutil.NewUserWithID(fmt.Sprintf("user-%d", id))
            if err := useCase.CreateUser(context.Background(), user); err != nil {
                errors <- err
            }
        }(i)
    }

    wg.Wait()
    close(errors)

    for err := range errors {
        t.Errorf("Concurrent operation failed: %v", err)
    }
}
```

## Performance Testing

### Benchmark Testing
Implement benchmarks following [internal/usecase/user_bench_test.go](mdc:gRPC-server/internal/usecase/user_bench_test.go):

```go
func BenchmarkUserUseCase_CreateUser(b *testing.B) {
    useCase := setupBenchmarkUseCase()
    user := testutil.NewValidUser()

    b.ResetTimer()
    for i := 0; i < b.N; i++ {
        user.ID = fmt.Sprintf("user-%d", i)
        err := useCase.CreateUser(context.Background(), user)
        if err != nil {
            b.Fatalf("CreateUser failed: %v", err)
        }
    }
}

func BenchmarkUserUseCase_GetUser(b *testing.B) {
    useCase := setupBenchmarkUseCase()

    // Pre-populate with test data
    users := make([]*domain.User, 1000)
    for i := 0; i < 1000; i++ {
        user := testutil.NewUserWithID(fmt.Sprintf("user-%d", i))
        useCase.CreateUser(context.Background(), user)
        users[i] = user
    }

    b.ResetTimer()
    for i := 0; i < b.N; i++ {
        userID := users[i%1000].ID
        _, err := useCase.GetUser(context.Background(), userID)
        if err != nil {
            b.Fatalf("GetUser failed: %v", err)
        }
    }
}
```

