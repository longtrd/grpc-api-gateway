# Dependency Injection and Container Management

## Container Pattern for Dependency Management
Based on the actual implementation in [internal/config/container.go](mdc:gRPC-server/internal/config/container.go) and integrated with [cmd/commands/start.go](mdc:gRPC-server/cmd/commands/start.go):

```go
// internal/config/container.go
type Container struct {
    // Configuration
    Config *Config
    Logger domain.Logger

    // Repositories
    UserRepository domain.UserRepository

    // Use Cases
    UserUseCase domain.UserUseCase

    // Validators
    UserValidator domain.UserValidator

    // Event Publisher
    EventPublisher domain.EventPublisher

    // Sync for lazy loading
    mu sync.RWMutex
}

func NewContainer(cfg *Config) (*Container, error) {
    container := &Container{
        Config: cfg,
    }

    if err := container.buildDependencies(); err != nil {
        return nil, fmt.Errorf("failed to build dependencies: %w", err)
    }

    return container, nil
}
```

## Dependency Building with Factory Methods
Based on [internal/config/container.go](mdc:gRPC-server/internal/config/container.go):

```go
func (c *Container) buildDependencies() error {
    // Build logger first
    if err := c.buildLogger(); err != nil {
        return fmt.Errorf("failed to build logger: %w", err)
    }

    // Build validators
    if err := c.buildValidators(); err != nil {
        return fmt.Errorf("failed to build validators: %w", err)
    }

    // Build event publisher
    if err := c.buildEventPublisher(); err != nil {
        return fmt.Errorf("failed to build event publisher: %w", err)
    }

    // Build repositories
    if err := c.buildRepositories(); err != nil {
        return fmt.Errorf("failed to build repositories: %w", err)
    }

    // Build use cases
    if err := c.buildUseCases(); err != nil {
        return fmt.Errorf("failed to build use cases: %w", err)
    }

    return nil
}

func (c *Container) buildLogger() error {
    c.Logger = logger.New(c.Config.Logger.Level, c.Config.Logger.Format)
    return nil
}

func (c *Container) buildValidators() error {
    c.UserValidator = validator.NewUserValidator()
    return nil
}

func (c *Container) buildEventPublisher() error {
    c.EventPublisher = mocks.NewMockEventPublisher()
    return nil
}

func (c *Container) buildRepositories() error {
    switch c.Config.Database.Type {
    case "memory":
        c.UserRepository = mocks.NewMockUserRepository()
    case "postgres":
        return fmt.Errorf("postgres repository not implemented yet")
    default:
        return fmt.Errorf("unsupported database type: %s", c.Config.Database.Type)
    }
    return nil
}

func (c *Container) buildUseCases() error {
    c.UserUseCase = usecase.NewUserUseCase(
        c.UserRepository,
        c.UserValidator,
        c.Logger,
        c.EventPublisher,
    )
    return nil
}
```

## Interface-Based Dependency Injection
Define clear interfaces for all dependencies:

```go
// internal/domain/interfaces.go
type UserRepository interface {
    Create(ctx context.Context, user *User) error
    GetByID(ctx context.Context, id string) (*User, error)
    Update(ctx context.Context, user *User) error
    Delete(ctx context.Context, id string) error
}

type UserValidator interface {
    Validate(user *User) error
}

type Logger interface {
    Info(msg string, fields ...interface{})
    Error(msg string, fields ...interface{})
    Debug(msg string, fields ...interface{})
}

type EventPublisher interface {
    Publish(ctx context.Context, event Event) error
}
```

## Constructor Injection Pattern
Use constructor injection for explicit dependencies:

```go
// internal/usecase/user.go
type UserUseCase struct {
    repo      domain.UserRepository
    validator domain.UserValidator
    logger    domain.Logger
    publisher domain.EventPublisher
}

func NewUserUseCase(
    repo domain.UserRepository,
    validator domain.UserValidator,
    logger domain.Logger,
    publisher domain.EventPublisher,
) *UserUseCase {
    return &UserUseCase{
        repo:      repo,
        validator: validator,
        logger:    logger,
        publisher: publisher,
    }
}
```

## Configuration-Driven Dependency Selection
Based on [internal/config/config.go](mdc:gRPC-server/internal/config/config.go):

```go
// internal/config/config.go
type Config struct {
    Server   ServerConfig   `yaml:"server"`
    Database DatabaseConfig `yaml:"database"`
    Logger   LoggerConfig   `yaml:"logger"`
    Features FeatureConfig  `yaml:"features"`
}

type ServerConfig struct {
    Port         string        `yaml:"port"`
    Host         string        `yaml:"host"`
    ReadTimeout  time.Duration `yaml:"read_timeout"`
    WriteTimeout time.Duration `yaml:"write_timeout"`
    MaxRecvSize  int           `yaml:"max_recv_size"`
    MaxSendSize  int           `yaml:"max_send_size"`
}

type DatabaseConfig struct {
    Type         string `yaml:"type"` // memory, postgres, mysql
    URL          string `yaml:"url"`
    MaxOpenConns int    `yaml:"max_open_conns"`
    MaxIdleConns int    `yaml:"max_idle_conns"`
}

type LoggerConfig struct {
    Level  string `yaml:"level"`  // debug, info, warn, error
    Format string `yaml:"format"` // json, text
}

type FeatureConfig struct {
    EnableMetrics     bool `yaml:"enable_metrics"`
    EnableTracing     bool `yaml:"enable_tracing"`
    EnableAuth        bool `yaml:"enable_auth"`
    EnableHealthCheck bool `yaml:"enable_health_check"`
}

// Load loads configuration from environment variables with defaults
func Load() *Config {
    return &Config{
        Server: ServerConfig{
            Port:         getEnv("GRPC_PORT", "50051"),
            Host:         getEnv("GRPC_HOST", "0.0.0.0"),
            ReadTimeout:  getDurationEnv("GRPC_READ_TIMEOUT", 30*time.Second),
            WriteTimeout: getDurationEnv("GRPC_WRITE_TIMEOUT", 30*time.Second),
            MaxRecvSize:  getIntEnv("GRPC_MAX_RECV_SIZE", 4*1024*1024),
            MaxSendSize:  getIntEnv("GRPC_MAX_SEND_SIZE", 4*1024*1024),
        },
        Database: DatabaseConfig{
            Type:         getEnv("DATABASE_TYPE", "memory"),
            URL:          getEnv("DATABASE_URL", ""),
            MaxOpenConns: getIntEnv("DATABASE_MAX_OPEN_CONNS", 25),
            MaxIdleConns: getIntEnv("DATABASE_MAX_IDLE_CONNS", 25),
        },
        Logger: LoggerConfig{
            Level:  getEnv("LOG_LEVEL", "info"),
            Format: getEnv("LOG_FORMAT", "json"),
        },
        Features: FeatureConfig{
            EnableMetrics:     getBoolEnv("ENABLE_METRICS", false),
            EnableTracing:     getBoolEnv("ENABLE_TRACING", false),
            EnableAuth:        getBoolEnv("ENABLE_AUTH", false),
            EnableHealthCheck: getBoolEnv("ENABLE_HEALTH_CHECK", true),
        },
    }
}
```

## Optional Dependencies with Feature Flags
```go
func (c *Container) buildOptionalDependencies() error {
    if c.Config.Features.EnableMetrics {
        c.MetricsService = metrics.NewPrometheusService()
    }

    if c.Config.Features.EnableTracing {
        tracer, err := tracing.NewJaegerTracer(c.Config.Tracing)
        if err != nil {
            return err
        }
        c.TracingService = tracer
    }

    if c.Config.Features.EnableAuth {
        c.AuthService = auth.NewJWTService(c.Config.Auth.Secret)
    }

    return nil
}
```

## Integration with Cobra Start Command
Update [cmd/commands/start.go](mdc:cmd/commands/start.go) to use the container:

```go
func runStart(cmd *cobra.Command, args []string) {
    // Load configuration
    cfg := config.Load()

    // Build dependency container
    container, err := config.NewContainer(cfg)
    if err != nil {
        log.Fatalf("Failed to build container: %v", err)
    }

    // Create and configure gRPC server
    server := createGRPCServer(container)

    // Register services
    pb.RegisterUserServiceServer(server, container.UserHandler)

    // Optional registrations based on features
    if container.Config.Features.EnableHealthCheck {
        registerHealthCheck(server, container)
    }

    // Start server
    lis, err := net.Listen("tcp", fmt.Sprintf(":%s", port))
    if err != nil {
        log.Fatalf("Failed to listen: %v", err)
    }

    setupGracefulShutdown(server, container.Logger)

    container.Logger.Printf("Starting gRPC server on port %s", port)
    if err := server.Serve(lis); err != nil {
        log.Fatalf("Failed to serve: %v", err)
    }
}
```

## Testing with Dependency Injection
Based on the actual implementation in [internal/config/container.go](mdc:gRPC-server/internal/config/container.go):

```go
// NewTestContainer creates a container for testing
func NewTestContainer() *Container {
    cfg := &Config{
        Logger: LoggerConfig{
            Level:  "debug",
            Format: "text",
        },
        Database: DatabaseConfig{
            Type: "memory",
        },
        Features: FeatureConfig{
            EnableHealthCheck: true,
        },
    }

    return &Container{
        Config:         cfg,
        Logger:         logger.NewNullLoggerInstance(), // Silent logger for tests
        UserRepository: mocks.NewMockUserRepository(),
        UserValidator:  mocks.NewMockUserValidator(),
        EventPublisher: mocks.NewMockEventPublisher(),
    }
}

// Test example using the container
func TestUserUseCase_WithContainer(t *testing.T) {
    container := config.NewTestContainer()

    // Use case is already wired up in test container
    user := testutil.NewValidUser()

    err := container.GetUserUseCase().CreateUser(context.Background(), user)
    assert.NoError(t, err)
}
```

## Graceful Resource Cleanup
```go
func (c *Container) Cleanup() error {
    var errors []error

    if closer, ok := c.DatabaseClient.(io.Closer); ok {
        if err := closer.Close(); err != nil {
            errors = append(errors, err)
        }
    }

    if c.TracingService != nil {
        if err := c.TracingService.Close(); err != nil {
            errors = append(errors, err)
        }
    }

    if len(errors) > 0 {
        return fmt.Errorf("cleanup errors: %v", errors)
    }

    return nil
}
```

## Lazy Loading for Heavy Dependencies
```go
type Container struct {
    // ... other fields

    databaseClient   DatabaseClient
    databaseClientOnce sync.Once
}

func (c *Container) GetDatabaseClient() DatabaseClient {
    c.databaseClientOnce.Do(func() {
        c.databaseClient = database.NewClient(c.Config.Database)
    })
    return c.databaseClient
}
```
