# gRPC Server Configuration
# Host and port settings
GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# Timeout settings (use Go duration format: 30s, 5m, 1h)
GRPC_READ_TIMEOUT=30s
GRPC_WRITE_TIMEOUT=30s

# Message size limits (in bytes)
GRPC_MAX_RECV_SIZE=4194304  # 4MB
GRPC_MAX_SEND_SIZE=4194304  # 4MB

# Database Configuration
# Supported types: memory, postgres
DATABASE_TYPE=memory
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
# DATABASE_MAX_OPEN_CONNS=25
# DATABASE_MAX_IDLE_CONNS=25

# Logging Configuration
# Levels: debug, info, warn, error
LOG_LEVEL=info
# Formats: json, text
LOG_FORMAT=json

# Feature Flags
# Health check service
ENABLE_HEALTH_CHECK=true
# Metrics collection (Prometheus)
ENABLE_METRICS=false
# Distributed tracing
ENABLE_TRACING=false
# Authentication/authorization
ENABLE_AUTH=false

# Environment
# Values: development, staging, production
ENVIRONMENT=development

# Security Configuration (when auth is enabled)
# JWT_SECRET=your-super-secret-jwt-key-here
# API_KEY=your-api-key-here
# AUTH_TOKEN_EXPIRY=24h

# Monitoring Configuration (when metrics are enabled)
# METRICS_PORT=9090
# METRICS_PATH=/metrics

# Tracing Configuration (when tracing is enabled)
# JAEGER_ENDPOINT=http://localhost:14268/api/traces
# TRACE_SAMPLE_RATE=0.1

# Development Settings
# Enable gRPC reflection (automatically enabled in debug mode)
# ENABLE_REFLECTION=true

# Production Settings
# TLS Configuration (for production)
# TLS_CERT_FILE=/path/to/cert.pem
# TLS_KEY_FILE=/path/to/key.pem
# TLS_CA_FILE=/path/to/ca.pem
